{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Mongo": {
    "ConnectionString": "<mongo-connection-string>",
    "Database": "chat_db"
  },
  "RabbitMQ": {
    "ConnectionString": "<rabbitmq-connection-string>"
  },
  "Redis": {
    "ConnectionString": "<redis-connection-string>"
  },
  "Jwt": {
    "Key": "<jwt-secret-key>",
    "Issuer": "uni-chat",
    "Audience": "uni-chat-users",
    "ExpireMinutes": 15
  },
  "RefreshToken": {
    "ExpireDays": 7
  },
  "Cloudinary": {
    "CloudName": "<cloud-name>",
    "ApiKey": "<api-key>",
    "ApiSecret": "<api-secret>"
  }
}