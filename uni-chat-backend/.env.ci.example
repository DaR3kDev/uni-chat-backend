# Valores dummy SOLO para desarrollo local / pruebas de compose.
# NO usar en producción. Copia: cp .env.ci.example .env
# Para deploy real: scripts/render-env.sh con GitHub Secrets (ver docs/github-secrets.md)

# =========================================================
# APP
# =========================================================
ASPNETCORE_ENVIRONMENT=Development
ENABLE_DOCS=true

# =========================================================
# DATABASE - MONGODB (LOCAL DOCKER)
# =========================================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=unichat
MONGO_CONNECTION_STRING=mongodb://admin:admin123@mongodb:27017/?authSource=admin

# =========================================================
# CACHE - REDIS (LOCAL DOCKER)
# =========================================================
REDIS_CONNECTION_STRING=redis:6379

# =========================================================
# MESSAGE BROKER - RABBITMQ (LOCAL DOCKER)
# =========================================================
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_CONNECTION_STRING=amqp://guest:guest@rabbitmq:5672

# =========================================================
# AUTH - JWT (DEV ONLY SECRET)
# =========================================================
JWT_KEY=ci-only-fake-jwt-key-minimum-32-characters-long
JWT_ISSUER=uni-chat
JWT_AUDIENCE=uni-chat-users
JWT_EXPIRE_MINUTES=15

# =========================================================
# REFRESH TOKENS
# =========================================================
REFRESH_EXPIRE_DAYS=7

# =========================================================
# FILE STORAGE - CLOUDINARY (DUMMY DEV VALUES)
# =========================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =========================================================
# ADMIN PANELS
# =========================================================
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=admin123

# =========================================================
# LOGGING - SEQ (LOCAL)
# =========================================================
SEQ_ADMIN=admin
SEQ_ADMIN_PASSWORD=admin123
